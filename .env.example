# ---- LLM (OpenAI) -----------------------------------------------------------
# Sem chave, o agente sobe em modo determinístico (LLM fake, roteiro fixo).
# Testes e evals NÃO precisam de chave.
OPENAI_API_KEY=
LLM_MODEL=gpt-5-mini
LLM_MODEL_CHEAP=gpt-5-nano
LLM_TIMEOUT_S=30

# ---- API de cotação (resiliência) ------------------------------------------
# Dentro do compose o host é quote-api; rodando local use http://localhost:8000
QUOTE_API_URL=http://quote-api:8000
QUOTE_TIMEOUT_S=1.5
QUOTE_MAX_ATTEMPTS=3
QUOTE_BACKOFF_BASE_S=0.4
BREAKER_CONSECUTIVE=5
BREAKER_COOLDOWN_S=30

# ---- Instabilidade simulada do quote-api (variáveis do próprio challenge) --
QUOTE_FAILURE_RATE=0.20
QUOTE_SLOW_RATE=0.10
QUOTE_SLOW_SECONDS=8
QUOTE_SEED=

# ---- Trace ------------------------------------------------------------------
TRACE_DIR=data/traces

# ---- Opcional: espelhar traces sanitizados no LangWatch cloud --------------
LANGWATCH_API_KEY=

# ---- Frontend ---------------------------------------------------------------
AGENT_API_URL=http://agent-api:8080
